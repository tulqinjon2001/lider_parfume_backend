PORT=3001

# PostgreSQL — Railway da avtomatik (Reference → DATABASE_URL)
# Lokal: Railway Postgres → Connect → Public URL yoki docker postgres
DATABASE_URL=postgresql://user:password@localhost:5432/lider_parfum

# Frontend domeni (CORS) — vergul bilan bir nechta
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
ADMIN_PASSWORD=your_admin_password_here

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=lider-parfum/products
